{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether Spike",
  "version": "0.0.0",
  "identifier": "dev.aether.spike",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
