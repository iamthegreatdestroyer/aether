{
  "name": "aether",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A free, personal-use weather app: Windy-class visualization, a forecast-verification ledger, and the atmosphere-to-space chain. $0/month.",
  "engines": {
    "node": ">=20.19.0"
  },
  "volta": {
    "node": "20.20.1"
  },
  "scripts": {
    "probe": "node scripts/probe-sources.mjs",
    "probe:a": "node scripts/probe-sources.mjs --tier A",
    "probe:json": "node scripts/probe-sources.mjs --json",
    "attribution": "node scripts/gen-attribution.mjs",
    "attribution:check": "node scripts/gen-attribution.mjs --check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
