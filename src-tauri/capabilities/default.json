{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Aether main window: core APIs plus scoped native HTTP for the A-native sources.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://kp.gfz.de/*" },
        { "url": "https://aviationweather.gov/*" }
      ]
    }
  ]
}
