{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.2.1",
  "identifier": "dev.aether.app",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1320,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "label": "main"
      },
      {
        "label": "widget",
        "title": "Aether widget",
        "url": "widget.html",
        "width": 380,
        "height": 148,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
